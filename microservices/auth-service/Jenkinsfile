pipeline {
    agent any
    options {
        skipDefaultCheckout(true)
    }

    environment {
        SERVICE_NAME = 'auth-service'
        SERVICE_DIR = 'microservices/auth-service'
        DOCKER_NET = 'microservices-fp_microservices-network'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                script {
                    docker.image('golang:1.25').inside("--network ${DOCKER_NET}") {
                        dir("${SERVICE_DIR}") {
                            sh '''
                            export GOMODCACHE="$WORKSPACE/.go/pkg/mod"
                            export GOCACHE="$WORKSPACE/.go/cache"
                            mkdir -p "$GOMODCACHE" "$GOCACHE"
                            go mod download
                            CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o auth-server ./cmd
                            '''
                        }
                    }
                }
            }
        }

        stage('Test') {
            steps {
                script {
                    docker.image('golang:1.25').inside("--network ${DOCKER_NET}") {
                        dir("${SERVICE_DIR}") {
                            sh '''
                            export GOMODCACHE="$WORKSPACE/.go/pkg/mod"
                            export GOCACHE="$WORKSPACE/.go/cache"
                            mkdir -p "$GOMODCACHE" "$GOCACHE"
                            go test ./... -coverprofile=coverage.out
                            '''
                        }
                    }
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    docker.image('sonarsource/sonar-scanner-cli:latest').inside("--network ${DOCKER_NET}") {
                        dir("${SERVICE_DIR}") {
                            withSonarQubeEnv('SonarQube') {
                                withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                                    sh '''
                                    sonar-scanner \
                                      -Dsonar.host.url="$SONAR_HOST_URL" \
                                      -Dsonar.login="$SONAR_TOKEN" \
                                      -Dsonar.projectKey=auth-service \
                                      -Dsonar.projectName="Auth Service"
                                    '''
                                }
                            }
                        }
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                    dir("${SERVICE_DIR}") {
                        sh '''
                        set -e
                        REPORT_FILE="target/sonar/report-task.txt"
                        if [ ! -f "$REPORT_FILE" ]; then
                          echo "report-task.txt not found; cannot evaluate quality gate"
                          exit 1
                        fi

                        CE_TASK_URL="$(grep '^ceTaskUrl=' "$REPORT_FILE" | cut -d= -f2-)"
                        if [ -z "$CE_TASK_URL" ]; then
                          echo "ceTaskUrl missing in $REPORT_FILE"
                          exit 1
                        fi

                        sqcurl() {
                          docker run --rm --network "${DOCKER_NET}" curlimages/curl:8.10.1 -s -u "$SONAR_TOKEN:" "$1"
                        }

                        echo "Polling Sonar CE task: $CE_TASK_URL"
                        for i in $(seq 1 60); do
                          CE_STATUS="$(sqcurl "$CE_TASK_URL" | sed -n 's/.*"status":"\\([^"]*\\)".*/\\1/p' | head -n1)"
                          if [ "$CE_STATUS" = "SUCCESS" ]; then
                            break
                          fi
                          if [ "$CE_STATUS" = "FAILED" ] || [ "$CE_STATUS" = "CANCELED" ]; then
                            echo "Sonar CE task failed with status $CE_STATUS"
                            exit 1
                          fi
                          sleep 5
                        done

                        QG_STATUS="$(sqcurl "http://sonarqube:9000/api/qualitygates/project_status?projectKey=auth-service" | sed -n 's/.*"status":"\\([^"]*\\)".*/\\1/p' | head -n1)"
                        echo "Quality Gate status: $QG_STATUS"
                        [ "$QG_STATUS" = "OK" ]
                        '''
                    }
                }
            }
        }

        stage('Package') {
            steps {
                sh '''
                COMPOSE_FILE="$(find "$WORKSPACE" "${WORKSPACE}@script" -maxdepth 4 -name docker-compose.yml 2>/dev/null | head -n 1)"
                if [ -z "${COMPOSE_FILE}" ]; then
                  echo "docker-compose.yml not found in workspace roots"
                  ls -la "$WORKSPACE" || true
                  ls -la "${WORKSPACE}@script" || true
                  exit 1
                fi
                COMPOSE_PROJECT_DIR="$(dirname "${COMPOSE_FILE}")"
                run_compose() {
                  if docker compose version >/dev/null 2>&1; then
                    docker compose -f "${COMPOSE_FILE}" --project-directory "${COMPOSE_PROJECT_DIR}" "$@"
                  elif command -v docker-compose >/dev/null 2>&1; then
                    docker-compose -f "${COMPOSE_FILE}" --project-directory "${COMPOSE_PROJECT_DIR}" "$@"
                  else
                    docker run --rm \
                      -v /var/run/docker.sock:/var/run/docker.sock \
                      --volumes-from "$(hostname)" -w "${COMPOSE_PROJECT_DIR}" \
                      docker:27-cli compose -f "${COMPOSE_FILE}" --project-directory "${COMPOSE_PROJECT_DIR}" "$@"
                  fi
                }

                run_compose up -d registry

                docker build \
                  -t "localhost:5000/${SERVICE_NAME}:${BUILD_NUMBER}" \
                  -t "localhost:5000/${SERVICE_NAME}:latest" \
                  "${SERVICE_DIR}"

                docker push "localhost:5000/${SERVICE_NAME}:${BUILD_NUMBER}"
                docker push "localhost:5000/${SERVICE_NAME}:latest"
                '''
            }
        }
    }

    post {
        always {
            dir("${SERVICE_DIR}") {
                archiveArtifacts artifacts: 'coverage.out,auth-server', allowEmptyArchive: true
            }
        }
    }
}
