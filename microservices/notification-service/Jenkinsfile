pipeline {
    agent any

    environment {
        // Path to your specific microservice
        SERVICE_DIR = 'microservices/notification-service'
        // The internal Docker network name found via 'docker network ls'
        DOCKER_NET  = 'microservices-fp_microservices-network'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build & Test') {
            agent {
                docker {
                    image 'maven:3.9-eclipse-temurin-17'
                    // Using the specific network and mounting the maven cache
                    args "-v maven_cache:/root/.m2 --network ${DOCKER_NET}"
                    reuseNode true
                }
            }
            steps {
                dir("${SERVICE_DIR}") {
                    // Clean, run tests, and package the jar
                    sh 'mvn -B clean verify'
                }
            }
        }

        stage('SonarQube Analysis') {
            agent {
                docker {
                    image 'maven:3.9-eclipse-temurin-17'
                    args "-v maven_cache:/root/.m2 --network ${DOCKER_NET}"
                    reuseNode true
                }
            }
            steps {
                dir("${SERVICE_DIR}") {
                    // 'SonarQube' must match the name in Manage Jenkins > System
                    withSonarQubeEnv('SonarQube') {
                        sh "mvn sonar:sonar -Dsonar.host.url=http://sonarqube:9000"
                    }
                }
            }
        }

        stage("Quality Gate") {
            steps {
                // Waits for SonarQube to report back. 
                // Requires a Webhook in SonarQube pointing to http://jenkins:8080/sonarqube-webhook/
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }
    }

    post {
        always {
            // Collects test results for the Jenkins UI
            junit testResults: "${SERVICE_DIR}/target/surefire-reports/*.xml", allowEmptyResults: true
            // Archives the final jar file
            archiveArtifacts artifacts: "${SERVICE_DIR}/target/*.jar", allowEmptyArchive: true
        }
        success {
            echo 'Build, Test, and Analysis completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the logs for connection or test issues.'
        }
    }
}
