pipeline {
    agent any

    environment {
        SERVICE_DIR = 'microservices/notification-service'
        DOCKER_NET  = 'microservices-fp_microservices-network'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build & Test') {
            steps {
                script {
                    docker.image('maven:3.9.6-eclipse-temurin-17').inside("-v /var/jenkins_home/.m2:/root/.m2 --network ${DOCKER_NET}") {
                        dir("${SERVICE_DIR}") {
                            sh 'mvn -B clean verify'
                        }
                    }
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    docker.image('maven:3.9.6-eclipse-temurin-17').inside("-v /var/jenkins_home/.m2:/root/.m2 --network ${DOCKER_NET}") {
                        dir("${SERVICE_DIR}") {
                            withSonarQubeEnv('SonarQube') {
                                withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                                    sh '''
                                    echo "Checking Sonar token..."
                                    curl -s -u "$SONAR_TOKEN": "$SONAR_HOST_URL/api/authentication/validate"
                                    mvn -B sonar:sonar \
                                      -Dsonar.host.url="$SONAR_HOST_URL" \
                                      -Dsonar.login="$SONAR_TOKEN" \
                                      -Dsonar.projectKey=notification-service \
                                      -Dsonar.projectName="Notification Service"
                                    '''
                                }
                            }
                        }
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }
    }

    post {
        always {
            dir("${SERVICE_DIR}") {
                junit testResults: 'target/surefire-reports/*.xml', allowEmptyResults: true
                archiveArtifacts artifacts: 'target/site/jacoco/**,target/*.jar', allowEmptyArchive: true
            }
        }
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the SonarQube logs or Quality Gate status.'
        }
    }
}
