pipeline {
    agent any

    environment {
        SERVICE_DIR = 'microservices/notification-service'
        DOCKER_NET  = 'microservices-fp_microservices-network'
    }

    stages {
        stage('Build & Test') {
            agent {
                docker {
                    image 'maven:3.9-eclipse-temurin-17'
                    args "-v maven_cache:/root/.m2 --network ${DOCKER_NET}"
                    reuseNode true
                }
            }
            steps {
                dir("${SERVICE_DIR}") {
                    sh 'mvn -B clean verify'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                    dir("${SERVICE_DIR}") {
                        sh '''
                        docker run --rm \
                            -u root \
                            --network ${DOCKER_NET} \
                            --volumes-from jenkins \
                            -e SONAR_HOST_URL=http://sonarqube:9000 \
                            -e SONAR_TOKEN=$SONAR_TOKEN \
                            -w "$WORKSPACE/${SERVICE_DIR}" \
                            sonarsource/sonar-scanner-cli:latest \
                            sonar-scanner \
                            -Dsonar.projectKey=notification-service \
                            -Dsonar.sources=src/main/java \
                            -Dsonar.java.binaries=target/classes \
                            -Dsonar.host.url=http://sonarqube:9000 \
                            -Dsonar.token=$SONAR_TOKEN
                        '''
                    }
                }
            }
        }

        stage('Quality Gate') {
    steps {
        withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
            dir("${SERVICE_DIR}") {
                sh '''
                set -e
                # Use the full workspace path to ensure we find the file
                REPORT_FILE="${WORKSPACE}/${SERVICE_DIR}/.scannerwork/report-task.txt"
                
                if [ ! -f "$REPORT_FILE" ]; then
                    echo "Error: report-task.txt not found at $REPORT_FILE"
                    exit 1
                fi

                CE_TASK_URL=$(grep ceTaskUrl "$REPORT_FILE" | cut -d= -f2-)
                
                echo "Checking SonarQube Task Status at: $CE_TASK_URL"
                
                for i in $(seq 1 20); do
                    RESPONSE=$(curl -s -u "$SONAR_TOKEN:" "$CE_TASK_URL")
                    STATUS=$(echo $RESPONSE | jq -r '.task.status')
                    
                    if [ "$STATUS" = "SUCCESS" ]; then 
                        ANALYSIS_ID=$(echo $RESPONSE | jq -r '.task.analysisId')
                        break 
                    fi
                    
                    if [ "$STATUS" = "FAILED" ] || [ "$STATUS" = "CANCELED" ]; then 
                        echo "SonarQube Task failed or was canceled."
                        exit 1 
                    fi
                    
                    echo "Waiting for SonarQube to process report... ($i/20)"
                    sleep 5
                done

                QG_STATUS=$(curl -s -u "$SONAR_TOKEN:" "http://sonarqube:9000/api/qualitygates/project_status?analysisId=$ANALYSIS_ID" | jq -r '.projectStatus.status')

                echo "Quality Gate Status: $QG_STATUS"
                
                if [ "$QG_STATUS" = "ERROR" ] || [ "$QG_STATUS" = "WARN" ]; then
                    echo "Quality Gate Failed! (Status: $QG_STATUS)"
                    exit 1
                elif [ "$QG_STATUS" = "OK" ]; then
                    echo "Quality Gate Passed!"
                fi
                '''
            }
        }
    }
}
    } 

    post {
        always {
            junit testResults: "${SERVICE_DIR}/target/surefire-reports/*.xml", allowEmptyResults: true
            archiveArtifacts artifacts: "${SERVICE_DIR}/target/*.jar", allowEmptyArchive: true
        }
        failure {
            echo "Pipeline failed. Revisa logs (especialmente SonarQube)."
        }
        success {
            echo "Pipeline exitoso con Quality Gate aprobado."
        }
    }
}
