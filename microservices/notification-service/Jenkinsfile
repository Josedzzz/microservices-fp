pipeline {
    agent any
    options {
        skipDefaultCheckout(true)
    }

    environment {
        SERVICE_NAME = 'notification-service'
        SERVICE_DIR = 'microservices/notification-service'
        DOCKER_NET = 'microservices-fp_microservices-network'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                script {
                    docker.image('maven:3.9.6-eclipse-temurin-17').inside("-v /var/jenkins_home/.m2:/root/.m2 --network ${DOCKER_NET}") {
                        dir("${SERVICE_DIR}") {
                            sh 'mvn -B clean package -DskipTests'
                        }
                    }
                }
            }
        }

        stage('Test') {
            steps {
                script {
                    docker.image('maven:3.9.6-eclipse-temurin-17').inside("-v /var/jenkins_home/.m2:/root/.m2 --network ${DOCKER_NET}") {
                        dir("${SERVICE_DIR}") {
                            sh 'mvn -B verify'
                        }
                    }
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    docker.image('maven:3.9.6-eclipse-temurin-17').inside("-v /var/jenkins_home/.m2:/root/.m2 --network ${DOCKER_NET}") {
                        dir("${SERVICE_DIR}") {
                            withSonarQubeEnv('SonarQube') {
                                withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                                    sh '''
                                    echo "Checking Sonar token..."
                                    curl -s -u "$SONAR_TOKEN": "$SONAR_HOST_URL/api/authentication/validate"
                                    mvn -B sonar:sonar \
                                      -Dsonar.host.url="$SONAR_HOST_URL" \
                                      -Dsonar.login="$SONAR_TOKEN" \
                                      -Dsonar.projectKey=notification-service \
                                      -Dsonar.projectName="Notification Service"
                                    '''
                                }
                            }
                        }
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                    dir("${SERVICE_DIR}") {
                        sh '''
                        set -e
                        REPORT_FILE="target/sonar/report-task.txt"
                        if [ ! -f "$REPORT_FILE" ]; then
                          echo "report-task.txt not found; cannot evaluate quality gate"
                          exit 1
                        fi

                        CE_TASK_URL="$(grep '^ceTaskUrl=' "$REPORT_FILE" | cut -d= -f2-)"
                        if [ -z "$CE_TASK_URL" ]; then
                          echo "ceTaskUrl missing in $REPORT_FILE"
                          exit 1
                        fi

                        sqcurl() {
                          docker run --rm --network "${DOCKER_NET}" curlimages/curl:8.10.1 -s -u "$SONAR_TOKEN:" "$1"
                        }

                        echo "Polling Sonar CE task: $CE_TASK_URL"
                        for i in $(seq 1 60); do
                          CE_STATUS="$(sqcurl "$CE_TASK_URL" | sed -n 's/.*"status":"\\([^"]*\\)".*/\\1/p' | head -n1)"
                          if [ "$CE_STATUS" = "SUCCESS" ]; then
                            break
                          fi
                          if [ "$CE_STATUS" = "FAILED" ] || [ "$CE_STATUS" = "CANCELED" ]; then
                            echo "Sonar CE task failed with status $CE_STATUS"
                            exit 1
                          fi
                          sleep 5
                        done

                        QG_STATUS="$(sqcurl "http://sonarqube:9000/api/qualitygates/project_status?projectKey=notification-service" | sed -n 's/.*"status":"\\([^"]*\\)".*/\\1/p' | head -n1)"
                        echo "Quality Gate status: $QG_STATUS"
                        [ "$QG_STATUS" = "OK" ]
                        '''
                    }
                }
            }
        }

        stage('Package & Publish') {
            steps {
                sh '''
                COMPOSE_FILE="${WORKSPACE}/docker-compose.yml"
                COMPOSE_PROJECT_DIR="${WORKSPACE}"

                run_compose() {
                  if docker compose version >/dev/null 2>&1; then
                    docker compose -f "${COMPOSE_FILE}" --project-directory "${COMPOSE_PROJECT_DIR}" "$@"
                  elif command -v docker-compose >/dev/null 2>&1; then
                    docker-compose -f "${COMPOSE_FILE}" --project-directory "${COMPOSE_PROJECT_DIR}" "$@"
                  else
                    docker run --rm \
                      -v /var/run/docker.sock:/var/run/docker.sock \
                      -v "${COMPOSE_PROJECT_DIR}:${COMPOSE_PROJECT_DIR}" -w "${COMPOSE_PROJECT_DIR}" \
                      docker/compose:latest -f "${COMPOSE_FILE}" --project-directory "${COMPOSE_PROJECT_DIR}" "$@"
                  fi
                }

                run_compose up -d registry

                docker build \
                  -t "localhost:5000/${SERVICE_NAME}:${BUILD_NUMBER}" \
                  -t "localhost:5000/${SERVICE_NAME}:latest" \
                  "${SERVICE_DIR}"

                docker push "localhost:5000/${SERVICE_NAME}:${BUILD_NUMBER}"
                docker push "localhost:5000/${SERVICE_NAME}:latest"
                '''
            }
        }

        stage('E2E Tests') {
            steps {
                sh '''
                set -e
                CI_PROJECT="ci-${BUILD_NUMBER}"
                COMPOSE_FILE="${WORKSPACE}/docker-compose.yml"
                COMPOSE_PROJECT_DIR="${WORKSPACE}"
                run_compose() {
                  if docker compose version >/dev/null 2>&1; then
                    docker compose -f "${COMPOSE_FILE}" --project-directory "${COMPOSE_PROJECT_DIR}" "$@"
                  elif command -v docker-compose >/dev/null 2>&1; then
                    docker-compose -f "${COMPOSE_FILE}" --project-directory "${COMPOSE_PROJECT_DIR}" "$@"
                  else
                    docker run --rm \
                      -v /var/run/docker.sock:/var/run/docker.sock \
                      -v "${COMPOSE_PROJECT_DIR}:${COMPOSE_PROJECT_DIR}" -w "${COMPOSE_PROJECT_DIR}" \
                      docker/compose:latest -f "${COMPOSE_FILE}" --project-directory "${COMPOSE_PROJECT_DIR}" "$@"
                  fi
                }

                run_compose --project-name "${CI_PROJECT}" --profile test up -d --build \
                  rabbitmq \
                  database-employees employees-service \
                  database-departments departments-service \
                  database-notifications notifications-service \
                  database-profiles profiles-service \
                  database-auth auth-service \
                  api-gateway

                NET="${CI_PROJECT}_onboarding-network"

                wait_for_http() {
                  name="$1"
                  url="$2"
                  max_tries="${3:-60}"
                  echo "Waiting for ${name} at ${url}"
                  for i in $(seq 1 "${max_tries}"); do
                    if docker run --rm --network "${NET}" curlimages/curl:8.10.1 -fsS "${url}" >/dev/null 2>&1; then
                      echo "${name} is ready"
                      return 0
                    fi
                    sleep 5
                  done
                  echo "Timeout waiting for ${name} (${url})"
                  return 1
                }

                wait_for_http "API Gateway" "http://api-gateway:8080/"
                wait_for_http "Auth Service" "http://auth-service:8083/api/swagger.yaml"
                wait_for_http "Employees Service" "http://employees-service:8081/api/health"
                wait_for_http "Departments Service" "http://departments-service:8082/api/"
                wait_for_http "Notifications Service" "http://notifications-service:8084/v3/api-docs"
                wait_for_http "Profiles Service" "http://profiles-service:8085/health"

                run_compose --project-name "${CI_PROJECT}" --profile test run --rm bdd-tests
                '''
            }
        }
    }

    post {
        always {
            dir("${SERVICE_DIR}") {
                junit testResults: 'target/surefire-reports/*.xml', allowEmptyResults: true
                archiveArtifacts artifacts: 'target/site/jacoco/**,target/*.jar', allowEmptyArchive: true
            }
            sh '''
            CI_PROJECT="ci-${BUILD_NUMBER}"
            COMPOSE_FILE="${WORKSPACE}/docker-compose.yml"
            COMPOSE_PROJECT_DIR="${WORKSPACE}"
            run_compose() {
              if docker compose version >/dev/null 2>&1; then
                docker compose -f "${COMPOSE_FILE}" --project-directory "${COMPOSE_PROJECT_DIR}" "$@"
              elif command -v docker-compose >/dev/null 2>&1; then
                docker-compose -f "${COMPOSE_FILE}" --project-directory "${COMPOSE_PROJECT_DIR}" "$@"
              else
                docker run --rm \
                  -v /var/run/docker.sock:/var/run/docker.sock \
                  -v "${COMPOSE_PROJECT_DIR}:${COMPOSE_PROJECT_DIR}" -w "${COMPOSE_PROJECT_DIR}" \
                  docker/compose:latest -f "${COMPOSE_FILE}" --project-directory "${COMPOSE_PROJECT_DIR}" "$@"
              fi
            }
            run_compose --project-name "${CI_PROJECT}" down -v --remove-orphans || true
            '''
        }
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check stage logs for details.'
        }
    }
}
